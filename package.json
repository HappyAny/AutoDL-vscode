{
  "name": "autodl-vscode",
  "displayName": "AutoDL Control",
  "description": "Quickly create, connect, stop, and release AutoDL Pro instances from VS Code.",
  "version": "0.2.3",
  "publisher": "happyan",
  "license": "MIT",
  "icon": "media/autodl-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/HappyAny/AutoDL-vscode.git"
  },
  "homepage": "https://github.com/HappyAny/AutoDL-vscode#readme",
  "bugs": {
    "url": "https://github.com/HappyAny/AutoDL-vscode/issues"
  },
  "keywords": [
    "autodl",
    "vscode",
    "ssh",
    "remote",
    "gpu",
    "jupyter"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:autodlInstances",
    "onCommand:autodl.setToken",
    "onCommand:autodl.refresh",
    "onCommand:autodl.refreshCatalogs",
    "onCommand:autodl.quickCreate",
    "onCommand:autodl.selectServer",
    "onCommand:autodl.setSshPublicKey",
    "onCommand:autodl.setSyncFolders",
    "onCommand:autodl.startFolderSync",
    "onCommand:autodl.uploadSyncFolder",
    "onCommand:autodl.stopFolderSync",
    "onCommand:autodl.cleanSshConfig",
    "onCommand:autodl.quickCreateLow",
    "onCommand:autodl.quickCreateMid",
    "onCommand:autodl.quickCreateHigh",
    "onCommand:autodl.turnOn",
    "onCommand:autodl.quickCloseAll"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "autodl",
          "title": "AutoDL",
          "icon": "media/autodl.svg"
        }
      ]
    },
    "views": {
      "autodl": [
        {
          "id": "autodlInstances",
          "name": "Instances",
          "contextualTitle": "AutoDL Instances"
        }
      ]
    },
    "commands": [
      {
        "command": "autodl.setToken",
        "title": "AutoDL: Set Token"
      },
      {
        "command": "autodl.clearToken",
        "title": "AutoDL: Clear Token"
      },
      {
        "command": "autodl.refresh",
        "title": "AutoDL: Refresh Instances",
        "icon": "$(refresh)"
      },
      {
        "command": "autodl.refreshCatalogs",
        "title": "AutoDL: Refresh GPU and Image Catalogs",
        "icon": "$(cloud-download)"
      },
      {
        "command": "autodl.quickCreate",
        "title": "AutoDL: Quick Create",
        "icon": "$(add)"
      },
      {
        "command": "autodl.selectServer",
        "title": "AutoDL: Select Server",
        "icon": "$(server)"
      },
      {
        "command": "autodl.setSshPublicKey",
        "title": "AutoDL: Set SSH Public Key"
      },
      {
        "command": "autodl.setSyncFolders",
        "title": "AutoDL: Set Sync Folders",
        "icon": "$(folder-opened)"
      },
      {
        "command": "autodl.startFolderSync",
        "title": "AutoDL: Start Folder Sync",
        "icon": "$(sync)"
      },
      {
        "command": "autodl.uploadSyncFolder",
        "title": "AutoDL: Upload Sync Folder",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "autodl.stopFolderSync",
        "title": "AutoDL: Stop Folder Sync"
      },
      {
        "command": "autodl.cleanSshConfig",
        "title": "AutoDL: Clean SSH Config"
      },
      {
        "command": "autodl.quickCreateLow",
        "title": "AutoDL: Quick Create Low"
      },
      {
        "command": "autodl.quickCreateMid",
        "title": "AutoDL: Quick Create Mid"
      },
      {
        "command": "autodl.quickCreateHigh",
        "title": "AutoDL: Quick Create High"
      },
      {
        "command": "autodl.connect",
        "title": "AutoDL: Connect with Remote SSH",
        "icon": "$(remote)"
      },
      {
        "command": "autodl.openJupyter",
        "title": "AutoDL: Open Jupyter",
        "icon": "$(globe)"
      },
      {
        "command": "autodl.stop",
        "title": "AutoDL: Shutdown Instance",
        "icon": "$(debug-stop)"
      },
      {
        "command": "autodl.turnOn",
        "title": "AutoDL: Turn On Instance",
        "icon": "$(debug-start)"
      },
      {
        "command": "autodl.release",
        "title": "AutoDL: Release Instance",
        "icon": "$(trash)"
      },
      {
        "command": "autodl.quickCloseAll",
        "title": "AutoDL: Stop and Release All Active Instances"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "autodl.refresh",
          "when": "view == autodlInstances",
          "group": "navigation@1"
        },
        {
          "command": "autodl.refreshCatalogs",
          "when": "view == autodlInstances",
          "group": "navigation@2"
        },
        {
          "command": "autodl.quickCreate",
          "when": "view == autodlInstances",
          "group": "navigation@3"
        },
        {
          "command": "autodl.selectServer",
          "when": "view == autodlInstances",
          "group": "navigation@4"
        },
        {
          "command": "autodl.setSyncFolders",
          "when": "view == autodlInstances",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "autodl.connect",
          "when": "view == autodlInstances && viewItem == autodlInstanceRunning",
          "group": "inline@1"
        },
        {
          "command": "autodl.openJupyter",
          "when": "view == autodlInstances && viewItem == autodlInstanceRunning",
          "group": "inline@2"
        },
        {
          "command": "autodl.uploadSyncFolder",
          "when": "view == autodlInstances && viewItem == autodlInstanceRunning",
          "group": "inline@3"
        },
        {
          "command": "autodl.stop",
          "when": "view == autodlInstances && viewItem == autodlInstanceRunning",
          "group": "actions@1"
        },
        {
          "command": "autodl.turnOn",
          "when": "view == autodlInstances && viewItem == autodlInstanceShutdown",
          "group": "actions@1"
        },
        {
          "command": "autodl.release",
          "when": "view == autodlInstances && (viewItem == autodlInstanceRunning || viewItem == autodlInstanceShutdown || viewItem == autodlInstanceOther)",
          "group": "actions@2"
        },
        {
          "command": "autodl.startFolderSync",
          "when": "view == autodlInstances && viewItem == autodlInstanceRunning",
          "group": "actions@3"
        }
      ],
      "commandPalette": [
        {
          "command": "autodl.clearToken"
        },
        {
          "command": "autodl.setSshPublicKey"
        },
        {
          "command": "autodl.setSyncFolders"
        },
        {
          "command": "autodl.startFolderSync"
        },
        {
          "command": "autodl.uploadSyncFolder"
        },
        {
          "command": "autodl.stopFolderSync"
        },
        {
          "command": "autodl.cleanSshConfig"
        },
        {
          "command": "autodl.quickCloseAll"
        }
      ]
    },
    "configuration": {
      "title": "AutoDL",
      "properties": {
        "autodl.apiBaseUrl": {
          "type": "string",
          "default": "https://api.autodl.com",
          "description": "AutoDL Pro API base URL."
        },
        "autodl.openRemotePath": {
          "type": "string",
          "default": "/root",
          "description": "Remote folder opened after connecting through Remote SSH."
        },
        "autodl.sshPublicKey": {
          "type": "string",
          "default": "",
          "description": "Public key injected into new instances during create. This lets Remote SSH connect without password once the start command has run."
        },
        "autodl.sshIdentityFile": {
          "type": "string",
          "default": "",
          "description": "Private key path written into managed SSH config for AutoDL hosts. Leave empty to let OpenSSH use default identities."
        },
        "autodl.injectSshPublicKeyOnCreate": {
          "type": "boolean",
          "default": true,
          "description": "Append autodl.sshPublicKey to /root/.ssh/authorized_keys during new instance creation."
        },
        "autodl.sync.localFolder": {
          "type": "string",
          "default": "",
          "description": "Local folder used for AutoDL bidirectional sync."
        },
        "autodl.sync.remoteFolder": {
          "type": "string",
          "default": "/root/autodl-sync",
          "description": "Remote folder used for AutoDL bidirectional sync."
        },
        "autodl.sync.intervalSeconds": {
          "type": "number",
          "default": 15,
          "description": "Polling interval for AutoDL folder sync."
        },
        "autodl.sync.excludeNames": {
          "type": "array",
          "default": [
            ".git",
            "node_modules",
            "__pycache__",
            ".venv",
            "venv",
            ".mypy_cache",
            ".pytest_cache"
          ],
          "items": {
            "type": "string"
          },
          "description": "Directory or file names ignored by AutoDL folder sync."
        },
        "autodl.waitTimeoutSeconds": {
          "type": "number",
          "default": 900,
          "description": "Timeout used when waiting for an instance status."
        },
        "autodl.waitIntervalSeconds": {
          "type": "number",
          "default": 5,
          "description": "Polling interval used when waiting for an instance status."
        },
        "autodl.quickCreate": {
          "type": "object",
          "default": {
            "defaults": {
              "image_uuid": "base-image-l2t43iu6uk",
              "cuda_min": 130,
              "gpu_amount": 1,
              "system_disk": 0,
              "data_centers": []
            },
            "profiles": {
              "low": {
                "label": "Low 4080(S) 32G",
                "gpu_spec_uuid": "v-32g-p"
              },
              "mid": {
                "label": "Mid 5090 32G",
                "gpu_spec_uuid": "5090-p"
              },
              "high": {
                "label": "High RTX PRO 6000",
                "gpu_spec_uuid": "pro6000-p"
              }
            }
          },
          "description": "Quick-create profiles and defaults. Values follow AutoDL Pro API payload names."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "node ./scripts/ensure-dist.cjs && vsce package --allow-missing-repository --out dist/autodl-control.vsix",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.3",
    "typescript": "^5.9.3"
  }
}
